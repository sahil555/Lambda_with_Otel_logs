    "serviceConfigFileName": "serverless.yml",
    "service": {
      "org": "555kureel",
      "service": "OCRExtractionLlm",
      "stages": {
        "default": {
          "params": {
            "tableName": "users-table-dev"
          }
        }
      },
      "custom": {
        "wsgi": {
          "app": "app.app",
          "packRequirements": false
        },
        "pythonRequirements": {
          "dockerizePip": true
        }
      },
      "provider": {
        "name": "aws",
        "runtime": "python3.12",
        "architecture": "arm64",
        "iam": {
          "role": {
            "statements": [
              {
                "Effect": "Allow",
                "Action": [
                  "dynamodb:Query",
                  "dynamodb:Scan",
                  "dynamodb:GetItem",
                  "dynamodb:PutItem",
                  "dynamodb:UpdateItem"
                ],
                "Resource": [
                  {
                    "Fn::GetAtt": [
                      "UsersTable",
                      "Arn"
                    ]
                  }
                ]
              }
            ]
          }
        },
        "environment": {
          "USERS_TABLE": "users-table-dev"
        },
        "stage": "dev",
        "region": "us-east-1",
        "versionFunctions": true
      },
      "functions": {
        "api": {
          "handler": "wsgi_handler.handler",
          "events": [
            {
              "http": {
                "path": "/",
                "method": "ANY"
              }
            },
            {
              "http": {
                "path": "/{proxy+}",
                "method": "ANY"
              }
            }
          ],
          "name": "OCRExtractionLlm-dev-api"
        }
      },
      "package": {
        "patterns": [
          "!.virtual_lambda/**"
        ],
        "artifactsS3KeyDirname": "serverless/OCRExtractionLlm/dev/code-artifacts"
      },
      "resources": {
        "Resources": {
          "UsersTable": {
            "Type": "AWS::DynamoDB::Table",
            "Properties": {
              "AttributeDefinitions": [
                {
                  "AttributeName": "userId",
                  "AttributeType": "S"
                }
              ],
              "KeySchema": [
                {
                  "AttributeName": "userId",
                  "KeyType": "HASH"
                }
              ],
              "ProvisionedThroughput": {
                "ReadCapacityUnits": 1,
                "WriteCapacityUnits": 1
              },
              "TableName": "users-table-dev"
            }
          }
        }
      },
      "plugins": [
        "serverless-offline",
        "serverless-wsgi"
      ]
    },
    "provider": {
      "name": "aws",
      "runtime": "python3.12",
      "architecture": "arm64",
      "iam": {
        "role": {
          "statements": [
            {
              "Effect": "Allow",
              "Action": [
                "dynamodb:Query",
                "dynamodb:Scan",
                "dynamodb:GetItem",
                "dynamodb:PutItem",
                "dynamodb:UpdateItem"
              ],
              "Resource": [
                {
                  "Fn::GetAtt": [
                    "UsersTable",
                    "Arn"
                  ]
                }
              ]
            }
          ]
        }
      },
      "environment": {
        "USERS_TABLE": "users-table-dev"
